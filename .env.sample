# --- Database Configuration ---
DB_URL=jdbc:mysql://mysql:3306/safe_db?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=admin
DB_PASSWORD=safe1234

# --- Security & JWT ---
JWT_SECRET=your_jwt_secret_key_here

# --- OAuth Configuration (Dummy values for local) ---
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_REDIRECT_URI=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173

# --- AWS Configuration ---
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY=your_access_key
AWS_SECRET_KEY=your_secret_key

# --- AI & External Services ---
OPENAI_API_KEY=your_openai_api_key_here
TOSS_PAYMENTS_SECRET_KEY=your_toss_secret_key

# --- Environment Specific (Added for Refinement) ---
# CORS 허용 주소 (쉼표로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 프론트엔드 API Base URL (배포 환경 등에 맞게 조정)
VITE_API_URL=/api

# 파이썬 AI 백엔드 URL
PYTHON_BACKEND_URL=http://python-backend:8000
